{
  "name": "@vazue/landing-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "CDK stack for queue.vazue.com marketing landing (S3 + CloudFront + ACM + Route 53)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
