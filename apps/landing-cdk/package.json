    "aws-cdk-lib": "^2.208.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.208.0",
    "typescript": "^5.9.2",
    "ts-node": "^10.9.2",
    "@types/node": "^24.2.0",
    "vitest": "^3.2.4"
  }
}
